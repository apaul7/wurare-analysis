// Copied from the upstream pipeline this was ported from.
// NO LONGER VERBATIM -- the `wurare` group profile below is local to this repo and has no
// upstream counterpart, and the preempt-queue comment is rewritten. When re-syncing against
// upstream, expect exactly those hunks of conflict and keep them.
//
// SLURM/compute2 execution profile, following the profile pattern documented in
// upstream's compute2 runbook (that file is not present in this repo).
//
// Everything cluster-specific lives inside the `compute2` profile, including the
// apptainer/executor blocks: at the top level they applied to every run, so a plain
// `nextflow run` with no -profile would still try to submit to SLURM and enable
// apptainer. Selecting no profile now means a local, container-less run.
profiles {
    cooper {
        params.SLURM = "compute2-cooper_m"
    }
    wurare {
        params.SLURM = "compute2-pdickson"
    }
    compute2 {
        apptainer {
            enabled    = true
            autoMounts = true
        }

        executor {
            name            = "slurm"
            queueSize       = 500
            submitRateLimit = "300/1min"
        }

        process {
            resourceLimits = [
                memory: 983.GB,
                cpus: 64,
                time: 15.d
            ]

            time = 15.d
            clusterOptions = "-A ${params.SLURM}"

            queue = {
                task.memory > 100.GB  ? "general-bigmem"  :
                // Every attempt goes to preemptible capacity, deliberately: it is free, and
                // with maxRetries = 3 a task gets four shots at it. To let attempts escape
                // preemption instead, lower 10 to 4 (final attempt only) or 3 (attempts 3 and
                // 4) -- both cost money, so this is an opt-in, not an un-applied TODO.
                task.attempt < 10      ? "general-preempt-cpu" :
                                        "general-cpu"
            }
            withLabel: "gpu" {
                queue = "general-preempt-gpu"
                clusterOptions   = "--gpus=4 -A ${params.SLURM}".trim()
                containerOptions = "--nv"
            }
            errorStrategy = "retry"
            maxRetries = 3
            executor = "slurm"
        }
    }
}
