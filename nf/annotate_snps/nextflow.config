manifest {
    name            = 'wurare-analysis/annotate_snps'
    author          = 'Alex Paul'
    description     = 'Cohort VCF -> per-interval CADD, SpliceAI, SQUIRLS and ANNOVAR annotation, merged to one multianno TSV'
    version         = '1.0.0dev'
    // 26.04.0, not 25.10.0: every module here sets `nextflow.enable.types = true`, and that
    // flag does not exist in any 25.10.x -- the run dies with "Unrecognized feature flag
    // 'nextflow.enable.types'" and every include reported as "Module could not be parsed".
    // Measured here against 25.10.0 (fails) and 26.04.6 (passes); the upstream pipeline measured
    // 25.10.7 as failing too.
    //
    // This does NOT buy a clean error: measured, Nextflow compiles the modules before it
    // checks this field, so 25.10.x still dies on the parse errors and the version check
    // never speaks. The value is the declaration itself -- it states the real floor for
    // anyone reading the manifest or provisioning a runner, where '>=25.10.0' stated a
    // version that cannot run this pipeline at all.
    nextflowVersion = '>=26.04.0'
}

includeConfig 'conf/igenomes.config'
includeConfig 'conf/params.config'
includeConfig '../shared/conf/compute2.config'

// Nextflow's publish location for the `output {}` block is controlled by outputDir (or
// -output-dir), which is entirely separate from params.outdir. Both default to "results",
// so without this line --outdir moves params.outdir while published files stay under the
// untouched default. See docs.seqera.io/nextflow/workflow.
outputDir = params.outdir

// Published files default to symlinks into the work dir, which break when work/ is cleaned.
workflow.output.mode = 'copy'
