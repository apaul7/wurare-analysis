// Default params for annotation resources and run identity. Override any of these on the
// command line or in a custom -params-file for a different run/dataset.
params {
    outdir = "results"

    // required, no sensible default -- differs per run
    vcf       = null   // cohort VCF to annotate
    tbi       = null   // its tabix index
    cohort    = null   // output filename component, e.g. WURARE
    data_type = null   // output filename component, e.g. wgs

    // reference.{fa,fai,dict} has a working public default and lives in
    // conf/igenomes.config.

    // No static interval list -- annotate_snps derives chromosome intervals at runtime
    // from what's actually in the input VCF (list_chroms), since targeted-panel data
    // leaves most of a static chr1..chrY list empty and CADD/SpliceAI/SQUIRLS all error
    // out on an empty VCF. This replaces wf's hardcoded chr1..chrY params.intervals.

    // Site-local resources with no public default. These are null rather than pointing at
    // one site's /storage1 layout: a null fails at startup with a named "required
    // parameter" error, where a stale absolute path failed later with a confusing
    // checkIfExists on a path the user never chose. wf's values, for reference:
    //
    //   cadd_data_dir           /storage1/fs1/WURare/Active/annotations/CADD/v1.6/
    //   squirls_config          /storage1/fs1/WURare/Active/annotations/squirls/c2.squirls-config.yml
    //   squirls_jannovar_model  .../squirls/jannovar_v0.35/hg38_refseq.ser
    //   annovar_dir             /storage1/fs1/WURare/Active/annotations/annovar/annovar/
    //   omim_xref               /storage1/fs1/WURare/Active/annotations/omim/20260702/gene_xref.annovar.txt
    cadd_data_dir          = null
    squirls_config         = null
    // wf calls this one `squirls_jannovar`; upstream's longer name is used here so
    // the shared squirls.nf copy keeps working unmodified.
    squirls_jannovar_model = null

    // wf sets only the .vcf.gz. The index is a separate param, not derived as
    // "${params.spliceai_precomputed_scores}.tbi": a derived index silently desyncs the
    // moment someone overrides the VCF, and it cannot express an index that does not sit
    // directly alongside its data. Confirm the .tbi exists on compute2 before the first
    // real run -- being required, a missing one fails at startup, not mid-run.
    spliceai_precomputed_scores = null   // wf: /storage1/fs1/WURare/Active/annotations/spliceai/splice.vcf.gz
    spliceai_precomputed_tbi    = null

    annovar_dir = null
    omim_xref   = null

    // annovar_parse_out_spliceai_squirls_scores.py -- host-local, not vendored anywhere,
    // so there is no default to give: file() accepts an http(s):// URL pinned to a commit
    // SHA as well as a local path. Renamed from wf's `add_scores_py`, which collided
    // confusingly with the unrelated add_scores.py heredoc'd inside spliceai.nf.
    annovar_splice_scores_script = null

    // ANNOVAR protocol name AND the source of the run date in every output filename:
    // annovar.nf splits on "_" and uses the second token, so <cohort>_<data_type>_20260627.
    // Must match a database actually present in ${annovar_dir}/humandb/.
    clinvar_date = "clinvar_20260627"

    // The table_annovar.pl protocol list, and the operation list that must line up with it
    // position for position. Here rather than inline in annovar.nf so that main.nf's humandb
    // preflight checks the same list the command actually sends -- written twice, the two drift,
    // and the check silently stops covering whatever was added to the command.
    //
    // CLINVAR is a placeholder, substituted with params.clinvar_date in main.nf. It cannot be a
    // GString: the v2 parser rejects one param referencing another inside this block outright
    // ("`clinvar_date` is not defined"), and a value baked at config-parse time would ignore a
    // --clinvar_date override anyway -- which is exactly the re-annotation path the README
    // documents.
    //
    // CADDv1.6 is in this list but is NOT expected in humandb beforehand; build_cadd_humandb
    // creates it at runtime and stage_humandb symlinks it in. The preflight skips it.
    //
    // variants_reduction.pl keeps its own hardcoded two-protocol list in annovar.nf. Both of its
    // entries are already here, so this preflight covers them -- and its output filename is
    // hardcoded to that list being exactly two long, so making it a param would let someone
    // break the handoff silently.
    annovar_protocols  = "refGene,genomicSuperDups,1000g2015aug_all,gnomad211_exome," +
                         "gnomad312_genome,gnomad40_genome,gnomad40_exome,gme,dbnsfp42a," +
                         "dbscsnv11,CLINVAR,gene4denovo201907,varity,CADDv1.6,alphamissense," +
                         "promoterai"
    annovar_operations = "gx,r,f,f,f,f,f,f,f,f,f,f,f,f,f,f"

    // Sample QC with somalier, optional and off by default. Unlike annotate_svs, nothing in
    // this pipeline CONSUMES the result -- there is no depth filter here to make ploidy-aware
    // -- so this is reporting: relatedness against what the PED claims, sex measured rather
    // than believed, and optionally ancestry. It is the sample-swap check this pipeline
    // otherwise has none of, and the cohort VCF it is handed is enough to compute it.
    //
    // With no --alignments sheet, extraction reads FORMAT/AD out of --vcf, so the sex call
    // is only as good as what the caller wrote -- and on a FILTERED callset (exomes
    // especially) it is not good at all: too few informative X/Y sites survive, every X
    // depth ratio drifts toward 1.0 and every Y toward 0, and the whole cohort reads as
    // female. For exomes, pass --alignments; the VCF path is for WGS cohorts whose VCF
    // still carries dense AD. A VCF without AD at all genotypes to zero depth, which fails
    // loudly (shared/assets/check_somalier.awk) instead of reporting a cohort of
    // undetermined samples. Relatedness needs only the genotypes and is unaffected.
    //
    // Source (GRCh38, this pipeline's only build):
    //   https://github.com/brentp/somalier/files/3412456/sites.hg38.vcf.gz
    //   listed with the releases at https://github.com/brentp/somalier/releases
    somalier_sites = null
    // OPTIONAL alignments sidecar: sample,alignment,alignment_index -- CRAM or BAM, same
    // sheet format as annotate_svs' --alignments. When set, somalier extracts real read
    // depth per sample from the alignments instead of from --vcf, which is what makes the
    // sex call trustworthy on exomes. The sheet defines who gets QC'd; its sample names
    // must match both the alignments' @RG SM (somalier_extract enforces this) and the VCF
    // header (for the summary report's per-sample joins).
    alignments = null
    // Required with alignments, and deliberately separate from params.reference: CRAM
    // cannot be decoded without the exact FASTA it was written against, and a silent
    // mismatch produces wrong depth rather than an error. The index is its own param for
    // the same reason spliceai_precomputed_tbi is.
    alignment_reference = null
    alignment_reference_index = null
    // OPTIONAL, and unused unless somalier_sites is set. With one it supplies the family
    // structure relatedness is compared against, and the sex column the measured one is
    // compared against. Without one the pedigree is inferred instead (somalier relate
    // --infer) and cross-checked against depth the same way -- so 04_qc always gains
    // ploidy.tsv and cohort.inferred.ped when somalier_sites is set. Requiring a pedigree
    // in order to look at the data would gate the check on paperwork.
    // Standard 6-column PED: family, sample, father, mother, sex, phenotype.
    ped = null
    // Ancestry, optional and all-or-none, and both need somalier_sites. Sources:
    //   labels   https://raw.githubusercontent.com/brentp/somalier/master/scripts/ancestry-labels-1kg.tsv
    //   1kg dir  https://zenodo.org/record/3479773/files/1kg.somalier.tar.gz  (unpack it;
    //            the param names the DIRECTORY of *.somalier files, not the tarball)
    somalier_labels  = null
    somalier_1kg_dir = null

    // Re-annotation entry points -- see the README's "Re-annotating without a full re-run".
    //
    // A prescored CADD table: #Chrom Pos Ref Alt RawScore PHRED, bgzipped and tabix-indexed
    // (tabix -s 1 -b 2 -e 2). Variants found in it take its scores and only the remainder
    // goes to CADD.sh, so cadd_data_dir stays required -- e.g. a cohort that grew since the
    // run that produced the table. Contigs may use either the callset's naming (a previous
    // run's 01_cadd/ output) or CADD's own Ensembl naming (raw CADD.sh output); the lookup
    // resolves both.
    //
    // With skip_spliceai_squirls ALSO set, the table instead passes through untouched --
    // nothing is scored, only ANNOVAR runs, and cadd_data_dir is not required. That mode
    // ASSUMES the table is complete and callset-named; main.nf warns, nothing verifies.
    // Both params or neither; main.nf enforces it.
    precomputed_cadd     = null
    precomputed_cadd_tbi = null

    // Asserts --vcf already carries SpliceAI and SQUIRLS INFO fields, i.e. that it is a
    // previous run's 03_annotated_vcf/ output. The two skip together because the only VCF
    // published sits after both; there is no artifact to re-enter between them.
    //
    // UNVERIFIED by design -- a plain VCF with this set produces empty splice columns rather
    // than an error, since add_splice_scores treats absent INFO as absent. main.nf logs a
    // warning naming the assumption.
    skip_spliceai_squirls = false
}
