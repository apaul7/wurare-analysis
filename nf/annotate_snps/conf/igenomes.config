// Public reference-data defaults, split out from conf/params.config so that file holds
// only tool settings and required-but-undefaulted inputs -- the same separation
// nf-core/sarek and the upstream pipeline use. Everything here has a working public default;
// everything without one stays in conf/params.config as null, guarded in main.nf.
//
// Resolving s3:// paths needs Nextflow's S3 filesystem support and AWS credentials/region
// configured. For repeated runs, download once and override with local paths.
params {
    // GATK.GRCh38 iGenomes, matching the upstream pipeline.
    //
    // NOT authoritative for this dataset. bcftools norm --check-ref s (normalize_vcf)
    // rewrites REF against whatever this is set to, so a mismatch here silently alters
    // REF alleles rather than failing. wf's own default is a compute1 path
    // (.../all_sequences.fa) that does not resolve on compute2, so neither repo's default
    // can be trusted -- override --reference.fa to the reference the input VCF was
    // actually called against.
    reference {
        fa   = "s3://ngi-igenomes/igenomes/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta"
        fai  = "s3://ngi-igenomes/igenomes/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.fasta.fai"
        dict = "s3://ngi-igenomes/igenomes/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38.dict"
    }
}
