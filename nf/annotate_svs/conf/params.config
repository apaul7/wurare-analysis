// Default params for annotate_svs. Override on the command line or in a -params-file.
params {
    outdir = "results"

    // required, no sensible default -- differs per run
    //
    // Two sheets rather than one. A multi-sample VCF cannot name a single alignment, and
    // folding alignment-only rows into the VCF sheet makes one sheet carry two record
    // types with mutually exclusive required columns.
    vcfs       = null   // sample_set,caller,joint,vcf,tbi
    alignments = null   // optional sidecar: sample,alignment,alignment_index
    // REQUIRED (resolved 2026-07-31). Standard 6-column PED: family, sample, father,
    // mother, sex, phenotype. It carries the family structure nothing else supplies, and its
    // sex column is the CROSS-CHECK against the sex somalier measures from the alignments --
    // never the source, because a mislabelled PED row and a swapped sample look identical
    // from inside this pipeline. Required rather than optional because the consumers
    // downstream -- inheritance filtering, sex-stratified AF, the Talos tail -- all need the
    // same file anyway. One required input beats three optional ones that have to agree.
    ped        = null

    // Site-local resources with no public default, following annotate_snps: null fails at
    // startup with a named "required parameter" error, where a stale absolute path fails
    // later with a confusing checkIfExists on a path the user never chose.
    //
    // Deliberately NOT the same knob as any annotation reference build, even when the
    // file is identical -- CRAM cannot be decoded without the exact FASTA it was written
    // against, and a silent mismatch produces wrong depth rather than an error. Required
    // once params.alignments is supplied (Phase 3).
    alignment_reference = null
    // Separate param, not derived as "${alignment_reference}.fai" -- a derived index
    // desyncs the moment someone overrides the FASTA, and cannot express an index that does
    // not sit beside its data. Same reasoning as annotate_snps' spliceai tbi.
    alignment_reference_index = null

    // somalier sites VCF. Optional, and only ever used alongside --alignments: with it,
    // sample sex is DERIVED FROM THE ALIGNMENTS
    // and the depth filter stops being autosome-only; without it, chrX/chrY stay exempt from
    // the depth tag exactly as they were, and the run says so.
    //
    // Must match the build of --alignment_reference. A sites file for the wrong build
    // genotypes nothing, which check_somalier.awk turns into a hard error rather than a
    // cohort of confidently undetermined samples.
    //
    // This is why samtools idxstats is not used for ploidy: index-only on BAM, but a full
    // pass over a CRAM ("does so by reading through the entire file" -- samtools-idxstats(1)),
    // no MAPQ filter, and no relatedness. somalier reads ~17k sites through the index.
    //
    // Source (GRCh38, this pipeline's only build):
    //   https://github.com/brentp/somalier/files/3412456/sites.hg38.vcf.gz
    //   listed with the releases at https://github.com/brentp/somalier/releases
    somalier_sites = null

    // somalier ancestry, optional and all-or-none. QC in its own right -- a predicted
    // ancestry contradicting the referral is the same class of signal as a relatedness
    // mismatch, and it is what makes a population-AF threshold defensible for a
    // non-European case. Nothing filters on it yet.
    //
    // Sources:
    //   labels   https://raw.githubusercontent.com/brentp/somalier/master/scripts/ancestry-labels-1kg.tsv
    //   1kg dir  https://zenodo.org/record/3479773/files/1kg.somalier.tar.gz  (unpack it;
    //            the param names the DIRECTORY of *.somalier files, not the tarball)
    somalier_labels  = null   // ancestry-labels TSV for the reference cohort
    somalier_1kg_dir = null   // directory of the labelled 1kg *.somalier files

    // Merge thresholds. Three knobs, not one: axis A reconciles callers over the same
    // samples and needs a looser overlap than axis B's cross-sample assembly, and
    // `svdb query` (Phase 4) has its own again. SVDB's own defaults are 0.95 / 2000, which
    // is strict enough to under-merge across callers -- and --ins_distance moved 50 -> 25
    // between 2.8.1 and 2.12.0, so these are set explicitly rather than inherited.
    overlap_axis_a = "0.6"
    overlap_axis_b = "0.8"
    bnd_distance   = "2000"
    // The third threshold, and the one known to have moved between releases. 25 is 2.12.0's
    // default and the container is pinned there, so setting it changes nothing today -- it
    // stops a container bump from silently re-clustering every INS.
    ins_distance   = "25"

    // Annotation resources. Site-local, no public default -- null fails at startup with a
    // named error, where a stale absolute path fails later on a path nobody chose.
    //
    // TWO gnomAD params, never one. gnomAD SV v4.1 is genome-based; the CNV callset is
    // exome-derived and a separate file. Conflating them produces wrong AFs reported
    // confidently rather than an error.
    gnomad_sv_vcf           = null   // genome SV callset
    gnomad_cnv_vcf          = null   // exome-derived CNV callset -- a DIFFERENT file

    // Which INFO keys each database holds its occurrence count and frequency under. svdb
    // reads these; get them wrong and it skips every database variant, warns per variant and
    // exits 0 with an unannotated VCF -- COMMON_GNOMAD then never fires and the population
    // filter does nothing. Verify against the files in hand before the first real run:
    //     bcftools view -h <file> | grep '^##INFO'
    // Defaults follow the gnomAD-SV sites convention; the exome CNV release differs, which
    // is why these are two pairs and not one.
    gnomad_sv_in_occ        = "AC"
    gnomad_sv_in_frq        = "AF"
    gnomad_cnv_in_occ       = "SC"
    gnomad_cnv_in_frq       = "SF"
    annotsv_annotations_dir = null   // AnnotSV bundle
    // The bundle's release, recorded in versions.yml. Supplied here because it CANNOT be
    // derived: nothing in the unpacked tree records it, AnnotSV reports its own version rather
    // than the bundle's, and the release number survives only in the download tarball's name,
    // which untar destroys. Nothing validates this against the bundle on disk -- update it by
    // hand when the bundle is upgraded, or versions.yml will confidently record the old one.
    annotsv_bundle_version  = "3.5"
    knotannotsv_config      = null   // knotAnnotSV config YAML

    genome_build = "GRCh38"

    // INFO keys stripped from the VCF handed to AnnotSV, comma-separated. AnnotSV copies
    // INFO into the TSV verbatim and a long value pushes a cell past Excel's 32767-character
    // limit, which makes the report unopenable for the people it is written for. smoove's
    // PRPOS/PREND are the usual offenders. Applied to the AnnotSV branch only -- the
    // published cohort VCF keeps every key. Empty keeps everything.
    //
    // SVDB's per-input blobs (<tag>_INFO, <tag>_SAMPLE, ...) do not belong here and are not
    // configurable: they are stripped from the AnnotSV input unconditionally, because their
    // key names are this cohort's input tags rather than anything a param could name. See
    // assets/list_blob_info_keys.awk.
    annotsv_drop_info = ""

    // Max BYTES per AnnotSV shard. This exists because of a HARD LIMIT, not a memory budget:
    // AnnotSV is Tcl, and Tcl 8 caps a single value at 2^31-1 = 2147483647 bytes. A 300-sample
    // cohort VCF measured 9.24 GB even after the strip above, and AnnotSV died in its first
    // step with "max size for a Tcl value (2147483647 bytes) exceeded". No amount of memory
    // moves that ceiling, so the input is split and the per-shard reports concatenated back.
    //
    // BYTES rather than a record count, and that distinction was learned the expensive way.
    // Bytes-per-record scales with sample count -- ~12.6 KB at 300 samples, nearly all of it
    // genotype columns, against a few hundred bytes for a handful of samples. The first
    // version of this param was a record count whose default came from a GUESSED record
    // count; it produced a 2,520,953,496-byte shard on the first real cohort, 17% over the
    // ceiling, discovered hours into the run. A byte budget is self-tuning across cohort
    // widths and expresses the actual constraint.
    //
    // 1e9 leaves 2.1x headroom under the ceiling, because it is not certain that the Tcl
    // value AnnotSV builds is the same size as the file it reads -- only that it tracks it.
    // Lower it for more shards and more headroom; each shard is an AnnotSV invocation that
    // loads the annotation bundle, so this trades wall-clock against safety margin.
    annotsv_shard_bytes = 1000000000

    // svdb query's own thresholds -- the third set after axis A and axis B, with their own
    // defaults. Not the merge knobs even though the flags share a name.
    query_overlap      = "0.6"
    query_bnd_distance = "10000"

    // Talos tail (Phase 6), optional and all-or-none. Talos is one consumer, not the goal
    // -- leaving these null skips the tail and costs nothing else.
    protein_coding_gtf = null   // for gatk SVAnnotate -> PREDICTED_LOF, Talos's hard gate
    noncoding_bed      = null   // ditto
    // ped is also read here for sex-stratified AF; it is declared above.
    gnomad_pop         = "gnomad_v4.1"   // Talos's default {GNOMAD_POP}_sv_AF prefix

    // Soft filter thresholds. These write FILTER tags; no record is ever removed, so
    // a threshold that is wrong for one consumer costs them a re-read of the tags rather
    // than a re-run of the pipeline.
    //
    // filter_internal_af has a hard floor at small N -- a het singleton in 10 samples is
    // AF 0.05 and would be tagged "common". Lean on the population AF while the cohort is
    // small.
    filter_pop_af       = "0.01"
    filter_internal_af  = "0.03"
    filter_del_dhffc    = "0.7"
    filter_dup_dhbfc    = "1.3"
    filter_min_callers  = "2"

    // AnnotSV TSV filter tiers. These REMOVE rows, which nothing else in this pipeline does
    // -- allowed only because the unfiltered TSV is published beside them and never replaced.
    // The active values are written into a header comment line on each filtered file, so
    // "what did this file filter on" is answerable from the file rather than from this one.
    //
    // AnnotSV runs in `both` mode, so the unfiltered TSV holds full rows (per SV) and split
    // rows (per SV x gene); both tiers keep SPLIT ROWS ONLY, because every criterion below
    // reads a per-transcript column that AnnotSV leaves blank on full rows. A filtered row is
    // therefore an SV x gene, and its row count is not a variant count -- one SV spanning
    // four genes contributes up to four rows. Deduplicate on ID to count variants.
    //
    // Tier 1 is the strict list: expect zero to a handful of rows per sample, and often an
    // empty file. That is the normal outcome, not a broken run. Tier 2 is the working list,
    // hundreds to thousands of rows.
    //
    // Tier 1 leans on FILTER=PASS, so its DEPTH_UNSUPPORTED component only excludes anything
    // once duphold has actually run -- which needs params.alignments, and on chrX/chrY also
    // needs params.somalier_sites for the ploidy the threshold is scaled by. Without
    // those, that part of the criterion passes everything.
    tsv_filter_rare_af    = "0.01"  // AnnotSV B_gain_AFmax / B_loss_AFmax ceiling (tier 1)
    tsv_filter_tier1_acmg = "4"     // ACMG_class 4 or 5 -- likely pathogenic and above
    tsv_filter_tier2_acmg = "3"     // 3+ keeps VUS, which is where a working list lives
    tsv_filter_pli_min    = "0.9"   // GnomAD_pLI at or above this counts as constrained
    tsv_filter_loeuf_max  = "2"     // ...or a LOEUF decile bin at or below this
    // Tier 2's alternative to ACMG_class, and mainly what rescues rows where AnnotSV left
    // ACMG_class as NA. AnnotSV's own scale puts >= 0.99 at class 5 and >= 0.90 at class 4.
    tsv_filter_rank_min   = "0.9"

    // Events below this are dropped at standardization: sub-50 bp calls are where merge
    // blowup and caller-convention noise live.
    min_sv_size = 50
}
